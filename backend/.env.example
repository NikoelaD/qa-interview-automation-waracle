# Backend environment (copy to .env). All values have safe defaults.
PORT=4000
JWT_SECRET=waracle-dev-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=*

# Phase 2 — database driver: "memory" (default, zero setup) or "mysql"
DB_DRIVER=memory

# Used only when DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waracle_store
